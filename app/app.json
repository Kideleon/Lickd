{
  "expo": {
    "name": "LICKD",
    "slug": "lickd",
    "scheme": "lickd",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "icon": "./assets/icon.png",
    "backgroundColor": "#0A0A0A",
    "newArchEnabled": true,
    "splash": { "image": "./assets/splash.png", "resizeMode": "contain", "backgroundColor": "#0A0A0A" },
    "ios": {
      "bundleIdentifier": "com.lickd.app",
      "supportsTablet": false,
      "infoPlist": { "ITSAppUsesNonExemptEncryption": false }
    },
    "android": {
      "package": "com.lickd.app",
      "adaptiveIcon": { "foregroundImage": "./assets/icon.png", "backgroundColor": "#0A0A0A" }
    },
    "plugins": [
      "expo-router",
      ["expo-image-picker", {
        "photosPermission": "LICKD uses your photos so you can share them on your profile, posts, stories and albums.",
        "cameraPermission": "LICKD uses your camera so you can take photos and videos to share."
      }],
      ["expo-notifications", { "color": "#FF2E93" }]
    ],
    "experiments": { "typedRoutes": false, "tsconfigPaths": true },
    "extra": {
      "router": {},
      "eas": { "projectId": "REPLACE_WITH_EAS_PROJECT_ID" }
    }
  }
}
